[mypy]
python_version = 3.10
files = .
# Sphinx build script and test scaffolding aren't part of the plugin code
exclude = ^(help|test)/
strict = True

# The dialogs subclass the form class uic.loadUiType() builds at runtime (Any)
[mypy-${TemplateModuleName}.${TemplateModuleName}_dialog]
disallow_subclassing_any = False
