    def __init__(self, iface: QgisInterface) -> None:
        """Constructor.

        :param iface: An interface instance that will be passed to this class
            which provides the hook by which you can manipulate the QGIS
            application at run time.
        """
        # Save reference to the QGIS interface
        self.iface = iface
        # initialize plugin directory
        self.plugin_dir = Path(__file__).parent
        # initialize locale
        locale = str(QgsSettings().value('locale/userLocale', QLocale().name()))[0:2]
        locale_path = self.plugin_dir / 'i18n' / f'{locale}.qm'

        if locale_path.exists():
            self.translator = QTranslator()
            self.translator.load(str(locale_path))
            QCoreApplication.installTranslator(self.translator)

        # Declare instance attributes
        self.actions: list[QAction] = []
        self.menu = self.tr('&${TemplateTitle}')

        # Dialog is lazily created on first run()
        self.dlg: ${TemplateClass}Dialog | None = None

    def tr(self, message: str) -> str:
        """Get the translation for a string using Qt translation API.
        We implement this ourselves since we do not inherit QObject.

        Wrap every user-visible string in self.tr(...). pylupdate6 scans the
        code for these calls to build the .ts translation files, filing each
        string under this class's name, the same context used below.

        :param message: String for translation.
        :returns: Translated version of message.
        """
        return QCoreApplication.translate('${TemplateClass}', message)

    def add_action(
        self,
        icon_path: str,
        text: str,
        callback: Callable[[], None],
        enabled_flag: bool = True,
        add_to_menu: bool = True,
        add_to_toolbar: bool = True,
        status_tip: str | None = None,
        whats_this: str | None = None,
        parent: QWidget | None = None,
    ) -> QAction:
        """Create a QAction and add it to the toolbar and/or the menu.

        A QAction is the object behind one menu item or toolbar button: it
        holds the icon, the label, and the function to run when clicked.

        :param icon_path: Path to the icon for this action. Can be a resource
            path (e.g. ':/plugins/foo/bar.png') or a normal file system path.
        :param text: Text that should be shown in menu items for this action.
        :param callback: Function to be called when the action is triggered.
        :param enabled_flag: A flag indicating if the action should be enabled
            by default. Defaults to True.
        :param add_to_menu: Flag indicating whether the action should also
            be added to the menu. Defaults to True.
        :param add_to_toolbar: Flag indicating whether the action should also
            be added to the toolbar. Defaults to True.
        :param status_tip: Optional short text shown in the QGIS status bar
            (bottom of the window) while the mouse hovers over the action.
        :param whats_this: Optional longer help text, shown when the user
            picks Help > What's This? and then clicks the action.
        :param parent: Parent widget for the new action. Defaults None.
        :returns: The action that was created. It is also added to the
            self.actions list, so that unload() can remove it.
        """

        icon = QIcon(icon_path)
        action = QAction(icon, text, parent)
        action.triggered.connect(callback)
        action.setEnabled(enabled_flag)

        if status_tip is not None:
            action.setStatusTip(status_tip)

        if whats_this is not None:
            action.setWhatsThis(whats_this)

        if add_to_toolbar:
            # Adds plugin icon to Plugins toolbar
            self.iface.addToolBarIcon(action)

        if add_to_menu:
            self.iface.${TemplateMenuAddMethod}(
                self.menu,
                action)
            # Show the icon on the submenu QGIS created for this plugin
            parent_menu = self.iface.${TemplateMenuGetter}()
            if parent_menu is not None:
                for menu_action in parent_menu.actions():
                    if menu_action.text() == self.menu:
                        menu_action.setIcon(icon)

        self.actions.append(action)

        return action

    def initGui(self) -> None:
        """Create the menu entries and toolbar icons inside the QGIS GUI.

        QGIS calls this when the plugin is loaded: at QGIS startup, or when
        the plugin is enabled in the Plugin Manager. Anything added here must
        be removed again in unload().
        """

        icon_path = str(Path(__file__).parent / 'icon.png')
        self.add_action(
            icon_path,
            text=self.tr('$TemplateMenuText'),
            callback=self.run,
            parent=self.iface.mainWindow())

    def unload(self) -> None:
        """Remove the plugin's menu items and toolbar icons from the QGIS GUI.

        QGIS calls this when the plugin is disabled, uninstalled or reloaded.
        It must undo everything initGui() did: anything left behind stays in
        QGIS, and each reload would add another copy.
        """
        for action in self.actions:
            self.iface.${TemplateMenuRemoveMethod}(
                self.tr('&${TemplateTitle}'),
                action)
            self.iface.removeToolBarIcon(action)

    def run(self) -> None:
        """Show the plugin's dialog and act on the result.

        QGIS calls this when the user clicks the plugin's menu item or
        toolbar button (connected in initGui()). This is where your plugin's
        own work goes.
