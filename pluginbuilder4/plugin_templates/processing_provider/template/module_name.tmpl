import sys
from pathlib import Path

from qgis.core import QgsApplication
from qgis.PyQt.QtCore import QCoreApplication, QTranslator

from .${TemplateModuleName}_provider import ${TemplateClass}Provider

cmd_folder = str(Path(__file__).parent)

if cmd_folder not in sys.path:
    sys.path.insert(0, cmd_folder)


class ${TemplateClass}Plugin:

    def __init__(self) -> None:
        self.provider: ${TemplateClass}Provider | None = None

        locale = QgsApplication.locale()[0:2]
        locale_path = Path(__file__).parent / "i18n" / f"{locale}.qm"
        if locale_path.exists():
            self.translator = QTranslator()
            self.translator.load(str(locale_path))
            QCoreApplication.installTranslator(self.translator)

    def tr(self, message: str) -> str:
        return QCoreApplication.translate("${TemplateClass}", message)

    def initProcessing(self) -> None:
        """Init Processing provider for QGIS >= 3.8."""
        registry = QgsApplication.processingRegistry()
        if registry is None:
            raise RuntimeError("Processing registry is not available")
        self.provider = ${TemplateClass}Provider()
        registry.addProvider(self.provider)

    def initGui(self) -> None:
        self.initProcessing()

    def unload(self) -> None:
        registry = QgsApplication.processingRegistry()
        if registry is not None and self.provider is not None:
            registry.removeProvider(self.provider)
