# coding=utf-8
"""DockWidget tests for ${TemplateClass}DockWidget."""

import pytest
from qgis.PyQt.QtWidgets import QDockWidget

# Imported under a neutral name: pytest would try to collect the class as a
# test class if the plugin's class name starts with "Test"
from ${TemplateModuleName}.${TemplateModuleName}_dockwidget import (
    ${TemplateClass}DockWidget as PluginDockWidget,
)


@pytest.fixture
def dockwidget(qgis_app):
    widget = PluginDockWidget(None)
    yield widget
    widget.close()


def test_dockwidget_is_qdockwidget(dockwidget):
    """The generated dockwidget is a QDockWidget instance."""
    assert isinstance(dockwidget, QDockWidget)


def test_dockwidget_has_closing_signal(dockwidget):
    """The dockwidget exposes a closingPlugin signal."""
    assert hasattr(dockwidget, "closingPlugin")
